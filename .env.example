# Hosted SQLite (Turso). Leave unset locally — uses data/makoons.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared secret for the board login and Grok MCP Bearer token.
# Required on Vercel. Local stays open if unset.
COMMAND_CENTER_TOKEN=

# Optional: host that should serve only MCP, e.g. mcp.makoons.viselle.net
MCP_SUBDOMAIN_HOST=
